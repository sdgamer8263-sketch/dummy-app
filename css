@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;800&family=Teko:wght@500;700&display=swap');

* { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Poppins', sans-serif; }

body {
    background: url('ccccccccccccccccc.gif') no-repeat center center fixed;
    background-size: cover; color: #ffffff; min-height: 100vh; display: flex; flex-direction: column;
}

.overlay {
    position: fixed; top: 0; left: 0; width: 100%; height: 100%;
    background: radial-gradient(circle, rgba(10,10,20,0.7) 0%, rgba(0,0,0,0.9) 100%); z-index: -1;
}

/* Header & Nav */
header {
    text-align: center; padding: 40px 20px 20px; background: rgba(25, 25, 35, 0.4);
    backdrop-filter: blur(12px); border-bottom: 2px solid rgba(0, 242, 254, 0.3);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
}
header img {
    width: 120px; height: auto; border-radius: 50%;
    box-shadow: 0 0 25px rgba(0, 242, 254, 0.8); margin-bottom: 15px; animation: pulse 2s infinite;
}
header h1 {
    font-family: 'Teko', sans-serif; font-size: 3.5rem; font-weight: 700; letter-spacing: 3px;
    background: linear-gradient(90deg, #00f2fe, #4facfe, #00f2fe); background-size: 200% auto;
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; animation: shine 3s linear infinite;
}
header p { color: #b3e5fc; font-size: 1.1rem; margin-top: 10px; }

nav { display: flex; justify-content: center; flex-wrap: wrap; gap: 15px; margin: 30px 0; padding: 0 20px; }
nav a {
    padding: 12px 20px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(0, 242, 254, 0.3);
    color: #fff; text-decoration: none; border-radius: 8px; font-weight: 600; transition: all 0.3s ease;
    backdrop-filter: blur(5px); font-size: 0.95rem;
}
nav a:hover, nav a.active {
    background: rgba(0, 242, 254, 0.2); border-color: #00f2fe;
    box-shadow: 0 0 15px rgba(0, 242, 254, 0.6); transform: translateY(-3px);
}

.section-title {
    text-align: center; font-family: 'Teko', sans-serif; font-size: 3rem; margin: 20px 0 30px;
    color: #fff; text-shadow: 0 0 15px rgba(0, 242, 254, 0.6); letter-spacing: 2px;
}

/* General Layouts */
.container {
    max-width: 1300px; margin: 0 auto 50px; padding: 0 20px;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 30px;
}
.addons-container {
    max-width: 900px; margin: 0 auto 50px; padding: 0 20px;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px;
}

/* Standard Cards */
.card {
    background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(15px);
    border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 20px; padding: 30px;
    transition: all 0.4s ease; position: relative; overflow: hidden; box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
}
.card:hover { transform: translateY(-10px); box-shadow: 0 15px 35px rgba(0, 242, 254, 0.4); border-color: rgba(0, 242, 254, 0.5); }
.card-header { text-align: center; margin-bottom: 20px; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 20px; }
.card-header h2 { font-size: 1.6rem; color: #00f2fe; margin-bottom: 10px; font-weight: 600; }
.price { font-size: 2.5rem; font-weight: 800; color: #fff; text-shadow: 0 0 10px rgba(255,255,255,0.3); }
.price span { font-size: 1.2rem; font-weight: 400; color: #00f2fe; }
.features { list-style: none; margin-bottom: 30px; }
.features li { margin-bottom: 12px; font-size: 1rem; color: #e0e0e0; display: flex; align-items: center; }
.features li i { width: 30px; color: #00f2fe; font-size: 1.2rem; }
.best-for {
    background: rgba(0, 242, 254, 0.1); padding: 10px; border-radius: 8px; font-size: 0.9rem;
    color: #b3e5fc; margin-bottom: 20px; border-left: 3px solid #00f2fe;
}
.btn {
    display: block; width: 100%; padding: 15px; text-align: center; border: none; border-radius: 12px;
    background: linear-gradient(45deg, #00f2fe, #4facfe); color: #fff; font-size: 1.1rem;
    font-weight: 600; text-decoration: none; text-transform: uppercase; cursor: pointer;
    transition: 0.3s; box-shadow: 0 5px 15px rgba(0, 242, 254, 0.4);
}
.btn:hover { background: linear-gradient(45deg, #4facfe, #00f2fe); transform: scale(1.03); }

/* Addon & Domain Cards */
.addon-card {
    background: rgba(20, 20, 30, 0.6); border: 1px dashed rgba(0, 242, 254, 0.5); padding: 20px;
    border-radius: 15px; text-align: center; backdrop-filter: blur(10px); transition: 0.3s;
}
.addon-card:hover { transform: translateY(-5px); border-color: #00f2fe; }
.addon-card i { font-size: 2rem; color: #ff9800; margin-bottom: 10px; }
.addon-card h3 { color: #fff; margin-bottom: 5px; }
.addon-card p { color: #00f2fe; font-weight: bold; font-size: 1.2rem; }

/* Themes Specific Cards */
.theme-card {
    background: rgba(20, 20, 35, 0.7); border: 1px solid rgba(0, 242, 254, 0.3); border-radius: 20px;
    padding: 30px; text-align: center; backdrop-filter: blur(15px); transition: all 0.4s ease; box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
}
.theme-card:hover { transform: translateY(-10px); box-shadow: 0 15px 35px rgba(0, 242, 254, 0.5); border-color: #00f2fe; }
.theme-icon { font-size: 3rem; color: #00f2fe; margin-bottom: 15px; text-shadow: 0 0 15px rgba(0, 242, 254, 0.6); }
.theme-title { font-size: 1.8rem; color: #fff; margin-bottom: 10px; font-family: 'Teko', sans-serif; }
.original-price { text-decoration: line-through; color: #ff5252; font-size: 1.2rem; margin-bottom: 5px; }
.discount-price { font-size: 2.5rem; font-weight: 800; color: #00f2fe; margin-bottom: 20px; text-shadow: 0 0 10px rgba(0, 242, 254, 0.4); }

/* Banners (Offers, Info, Delivery, VDS, CTA) */
.cta-banner, .vds-banner, .info-banner {
    max-width: 900px; margin: 0 auto 40px; padding: 30px; border-radius: 20px; text-align: center; backdrop-filter: blur(15px);
}
.cta-banner { background: linear-gradient(135deg, rgba(0, 242, 254, 0.1), rgba(79, 172, 254, 0.2)); border: 1px solid rgba(0, 242, 254, 0.5); box-shadow: 0 10px 30px rgba(0, 242, 254, 0.2); }
.cta-banner h2 { font-size: 2rem; color: #fff; margin-bottom: 15px; font-family: 'Teko', sans-serif; letter-spacing: 2px; }
.ticket-btn { display: inline-block; padding: 12px 30px; background: linear-gradient(90deg, #00f2fe, #4facfe); color: #fff; font-weight: 600; border-radius: 10px; text-decoration: none; transition: 0.3s; box-shadow: 0 5px 15px rgba(0, 242, 254, 0.4); }
.ticket-btn:hover { transform: scale(1.05); }
.offer-banner {
    max-width: 900px; margin: 40px auto 50px; padding: 30px; background: linear-gradient(135deg, rgba(255, 152, 0, 0.1), rgba(255, 87, 34, 0.2));
    border: 2px dashed rgba(255, 152, 0, 0.6); border-radius: 20px; text-align: center; animation: pulse-orange 2s infinite;
}
.offer-banner h2 { font-size: 2.2rem; color: #ff9800; font-family: 'Teko', sans-serif; margin-bottom: 10px; }
.info-banner { background: linear-gradient(135deg, rgba(76, 175, 80, 0.1), rgba(0, 230, 118, 0.2)); border: 1px solid #00e676; padding: 20px; }
.info-banner h3 { color: #00e676; margin-bottom: 10px; }
.setup-banner, .delivery-alert, .update-banner { max-width: 900px; margin: 0 auto 40px; padding: 15px; border-radius: 10px; text-align: center; font-weight: 600; }
.setup-banner { background: rgba(255, 193, 7, 0.1); border: 1px dashed #ffc107; color: #ffc107; }
.delivery-alert { background: rgba(255, 152, 0, 0.1); border: 1px dashed #ff9800; color: #ffb74d; box-shadow: 0 5px 15px rgba(255, 152, 0, 0.2); }
.update-banner { background: rgba(0, 242, 254, 0.1); border: 1px solid #00f2fe; color: #fff; }
.vds-banner { background: linear-gradient(135deg, rgba(233, 30, 99, 0.1), rgba(156, 39, 176, 0.2)); border: 1px solid #e91e63; padding: 20px; }
.vds-banner h3 { color: #ff4081; font-size: 1.6rem; font-family: 'Teko', sans-serif; }

/* VDS Features Grid */
.features-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin: 0 auto 50px; max-width: 1000px; padding: 0 20px; }
.feature-item { background: rgba(255, 255, 255, 0.05); padding: 20px; border-radius: 12px; text-align: center; border: 1px solid rgba(0, 242, 254, 0.2); }
.feature-item i { font-size: 2rem; color: #00f2fe; margin-bottom: 10px; }

/* TOS Specific */
.tos-container { max-width: 1300px; margin: 0 auto 50px; padding: 0 20px; display: grid; grid-template-columns: repeat(auto-fit, minmax(400px, 1fr)); gap: 30px; }
.tos-card { background: rgba(25, 25, 35, 0.6); border: 1px solid rgba(0, 242, 254, 0.2); border-radius: 15px; padding: 25px; backdrop-filter: blur(10px); transition: all 0.3s ease; }
.tos-card:hover { border-color: rgba(0, 242, 254, 0.6); box-shadow: 0 5px 20px rgba(0, 242, 254, 0.2); transform: translateY(-5px); }
.tos-card h3 { color: #00f2fe; font-size: 1.5rem; margin-bottom: 15px; font-family: 'Teko', sans-serif; border-bottom: 1px solid rgba(255, 255, 255, 0.1); padding-bottom: 10px; }
.tos-card p { color: #ccc; line-height: 1.6; margin-bottom: 10px; }
.tos-list { list-style: none; padding-left: 0; }
.tos-list li { color: #ddd; margin-bottom: 10px; display: flex; align-items: flex-start; gap: 10px; line-height: 1.5; }
.tos-list li i { color: #4facfe; margin-top: 4px; }
.tos-list li.warning i { color: #ff5252; }
.tos-list li.success i { color: #00e676; }
.refund-highlight { background: rgba(255, 152, 0, 0.15); border-left: 4px solid #ff9800; padding: 10px; margin-top: 15px; border-radius: 4px; color: #ffb74d; }

/* Footer */
footer { text-align: center; padding: 25px; background: rgba(0, 0, 0, 0.85); backdrop-filter: blur(10px); border-top: 1px solid rgba(255, 255, 255, 0.1); margin-top: auto; }
footer p { color: #888; }
footer span { color: #00f2fe; font-weight: 600; font-family: 'Teko', sans-serif; font-size: 1.5rem; letter-spacing: 1px; }

/* Animations */
@keyframes pulse { 0% { box-shadow: 0 0 15px rgba(0, 242, 254, 0.5); } 50% { box-shadow: 0 0 35px rgba(0, 242, 254, 0.9); } 100% { box-shadow: 0 0 15px rgba(0, 242, 254, 0.5); } }
@keyframes pulse-orange { 0% { box-shadow: 0 0 15px rgba(255, 152, 0, 0.3); } 50% { box-shadow: 0 0 25px rgba(255, 152, 0, 0.6); } 100% { box-shadow: 0 0 15px rgba(255, 152, 0, 0.3); } }
@keyframes shine { to { background-position: 200% center; } }
  
